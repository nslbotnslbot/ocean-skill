{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nslbotnslbot/ocean-skill/schemas/source_packet_v2.schema.json",
  "title": "OCEAN SourcePacket v2",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "source",
    "evidence_state",
    "locator_mode",
    "locators",
    "supports_claims",
    "cannot_support",
    "upstream_dependencies",
    "conflict_state",
    "recheck_policy",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "ocean-source-packet-v2"},
    "packet_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["source_type", "source_id", "retrieved_at", "checksum"],
      "properties": {
        "source_type": {"type": "string"},
        "source_id": {"type": "string"},
        "title": {"type": "string"},
        "url": {"type": "string"},
        "version": {"type": "string"},
        "retrieved_at": {"type": "string"},
        "checksum": {"type": "string"},
        "access_mode": {
          "enum": ["public", "controlled", "private", "local", "unknown"]
        }
      }
    },
    "evidence_state": {
      "enum": [
        "candidate",
        "inspected",
        "queried_evidence",
        "conflicting",
        "unavailable"
      ]
    },
    "locator_mode": {
      "enum": ["page-grounded", "structure-grounded", "source-limited"]
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locator_id", "locator_type", "value"],
        "properties": {
          "locator_id": {"type": "string"},
          "locator_type": {
            "enum": [
              "page",
              "section",
              "paragraph",
              "figure",
              "table",
              "supplement",
              "record",
              "field",
              "line"
            ]
          },
          "value": {"type": "string"},
          "excerpt_checksum": {"type": "string"}
        }
      }
    },
    "supports_claims": {"type": "array", "items": {"type": "string"}},
    "cannot_support": {"type": "array", "items": {"type": "string"}},
    "upstream_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dependency_id", "relation"],
        "properties": {
          "dependency_id": {"type": "string"},
          "relation": {"type": "string"},
          "source_family": {"type": "string"}
        }
      }
    },
    "conflict_state": {
      "enum": ["none_observed", "possible", "confirmed", "unknown"]
    },
    "recheck_policy": {
      "type": "object",
      "required": ["stale_after", "recheck_trigger"],
      "properties": {
        "stale_after": {"type": "string"},
        "recheck_trigger": {"type": "array", "items": {"type": "string"}},
        "supersedes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_boundary": {
      "type": "object",
      "required": ["inspected", "not_inspected", "cannot_conclude", "next_required"],
      "properties": {
        "inspected": {"type": "array", "items": {"type": "string"}},
        "not_inspected": {"type": "array", "items": {"type": "string"}},
        "cannot_conclude": {"type": "array", "items": {"type": "string"}},
        "next_required": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": true
}
