{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nslbotnslbot/ocean-skill/schemas/adjudication_record.schema.json",
  "title": "OCEAN Human Adjudication Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "case_id",
    "blinding_state",
    "reviewers",
    "rubric_version",
    "independent_decisions",
    "final_decision",
    "disagreement_resolution",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "ocean-adjudication-record-v1"},
    "record_id": {"type": "string"},
    "case_id": {"type": "string"},
    "blinding_state": {"enum": ["blinded", "partially_blinded", "unblinded"]},
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["reviewer_id", "expertise", "conflict_declared"],
        "properties": {
          "reviewer_id": {"type": "string"},
          "expertise": {"type": "string"},
          "conflict_declared": {"type": "boolean"}
        }
      }
    },
    "rubric_version": {"type": "string"},
    "independent_decisions": {"type": "array", "items": {"type": "object"}},
    "final_decision": {
      "enum": ["accepted", "rejected", "modified", "genuinely_ambiguous"]
    },
    "disagreement_resolution": {"type": "object"},
    "evidence_boundary": {
      "type": "object",
      "required": ["inspected", "not_inspected", "cannot_conclude", "next_required"]
    }
  },
  "additionalProperties": true
}
