{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCEAN Visual Style Memory",
  "type": "object",
  "required": [
    "schema_version",
    "default_profile_id",
    "profiles",
    "project_memory",
    "history"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ocean-visual-style-memory-v1"
    },
    "default_profile_id": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "profile_id",
          "name",
          "palette",
          "typography",
          "lines",
          "legend",
          "annotation",
          "background",
          "intended_use"
        ],
        "properties": {
          "profile_id": {"type": "string"},
          "name": {"type": "string"},
          "palette": {
            "type": "array",
            "items": {"type": "string"}
          },
          "typography": {"type": "string"},
          "lines": {"type": "string"},
          "legend": {"type": "string"},
          "annotation": {"type": "string"},
          "background": {"type": "string"},
          "intended_use": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "artifact_type_defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional artifact-family defaults used as pre-feedback warm-starts."
    },
    "project_memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project_id",
          "active_profile_id",
          "accepted_aspects",
          "rejected_aspects",
          "next_tuning_request",
          "last_changed"
        ],
        "properties": {
          "project_id": {"type": "string"},
          "active_profile_id": {"type": "string"},
          "accepted_aspects": {
            "type": "array",
            "items": {"type": "string"}
          },
          "rejected_aspects": {
            "type": "array",
            "items": {"type": "string"}
          },
          "next_tuning_request": {"type": "string"},
          "last_changed": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "artifact_memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "active_profile_id",
          "accepted_aspects",
          "rejected_aspects",
          "next_tuning_request",
          "last_changed"
        ],
        "properties": {
          "artifact_type": {"type": "string"},
          "active_profile_id": {"type": "string"},
          "last_project_id": {"type": "string"},
          "accepted_aspects": {
            "type": "array",
            "items": {"type": "string"}
          },
          "rejected_aspects": {
            "type": "array",
            "items": {"type": "string"}
          },
          "next_tuning_request": {"type": "string"},
          "last_changed": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "artifact_type_affinity": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "profile_scores": {
            "type": "object",
            "additionalProperties": {"type": "number"}
          }
        },
        "additionalProperties": true
      }
    },
    "module_memory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {"type": "string"},
          "active_profile_id": {"type": "string"},
          "last_project_id": {"type": "string"},
          "accepted_aspects": {"type": "array", "items": {"type": "string"}},
          "rejected_aspects": {"type": "array", "items": {"type": "string"}},
          "next_tuning_request": {"type": "string"},
          "last_changed": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "learning": {
      "type": "object",
      "properties": {
        "project_affinity": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "profile_scores": {
                "type": "object",
                "additionalProperties": {"type": "number"}
              }
            },
            "additionalProperties": true
          }
        },
        "module_affinity": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "profile_scores": {
                "type": "object",
                "additionalProperties": {"type": "number"}
              }
            },
            "additionalProperties": true
          }
        },
        "aspect_feedback": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "accepted": {"type": "integer"},
              "rejected": {"type": "integer"}
            },
            "additionalProperties": true
          }
        },
        "updated_at_utc": {"type": "string"}
      },
      "additionalProperties": true
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "project_id",
          "timestamp",
          "profile_id",
          "feedback",
          "accepted_aspects",
          "rejected_aspects",
          "next_tuning_request"
        ],
        "properties": {
          "event_id": {"type": "string"},
          "project_id": {"type": "string"},
          "timestamp": {"type": "string"},
          "profile_id": {"type": "string"},
          "feedback": {
            "enum": [
              "accepted",
              "partially_accepted",
              "rejected",
              "pending"
            ]
          },
          "accepted_aspects": {
            "type": "array",
            "items": {"type": "string"}
          },
          "rejected_aspects": {
            "type": "array",
            "items": {"type": "string"}
          },
          "next_tuning_request": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
